# ===========================================
# ClimateTwin Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Backend Configuration
PROJECT_NAME="ClimateTwin API"
DEBUG=True
API_V1_STR="/api"

# Security — REQUIRED for production
JWT_SECRET_KEY=your-random-256-bit-secret-key-here

# Demo User Passwords (set to seed initial users)
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_VIEWER_PASSWORD=

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=climatetwin

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# External Data Sources (obtain your own keys)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
KAGGLE_USERNAME=
KAGGLE_KEY=
NASA_FIRMS_KEY=

# AI/LLM API (optional)
OPENROUTER_API_KEY=
